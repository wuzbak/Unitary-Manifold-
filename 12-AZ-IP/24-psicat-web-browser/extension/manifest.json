{
  "manifest_version": 3,
  "name": "PsiCat Browser Companion",
  "version": "1.0.0",
  "description": "PsiCat notebook, page capture, and interrogation companion for Chrome and Edge.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "downloads", "contextMenus", "sidePanel"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PsiCat Browser Companion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
