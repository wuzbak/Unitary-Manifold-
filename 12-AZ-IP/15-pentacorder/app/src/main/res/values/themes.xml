<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Pentacorder" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/gibber_green</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorPrimaryContainer">@color/gibber_green</item>
        <item name="colorOnPrimaryContainer">@color/background_dark</item>

        <item name="colorSecondary">@color/gibber_blue</item>
        <item name="colorOnSecondary">@color/on_surface</item>
        <item name="colorSecondaryContainer">@color/gibber_blue</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>

        <item name="colorTertiary">@color/gibber_amber</item>
        <item name="colorOnTertiary">@color/background_dark</item>
        <item name="colorTertiaryContainer">@color/gibber_amber</item>
        <item name="colorOnTertiaryContainer">@color/background_dark</item>

        <item name="colorError">@color/gibber_red</item>
        <item name="colorOnError">@color/on_surface</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface</item>

        <!-- Status / nav bars -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
