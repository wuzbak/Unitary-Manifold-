# Unitary Pentacorder — Android App
# Package: com.axiomzero.pentacorder

# Ollama local endpoint (served from Termux on-device)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Sensor bridge — 5D metric mapping constants
KK_WINDING_N=5
KK_K_CS=74
KK_C_S=0.324324

# Pentad gate threshold
PENTAD_GATE=0.324324
