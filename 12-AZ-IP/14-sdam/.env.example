# SDAM — Software-Defined Acoustic Modem
# Android Keystore config (for release signing)
KEYSTORE_PATH=./android/release.jks
KEYSTORE_ALIAS=sdam-release
# KEYSTORE_PASSWORD=...  (set in CI secrets, NOT here)

# ggwave frequency range
SDAM_FREQ_LOW=17000
SDAM_FREQ_HIGH=22000

# Operational mode default: GREEN=15, RED=80, BLUE=20, AMBER=40
SDAM_DEFAULT_VOLUME=15
SDAM_DEFAULT_MODE=GREEN
