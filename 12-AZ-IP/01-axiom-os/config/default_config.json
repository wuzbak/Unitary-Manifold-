{
  "version": "1.0",
  "platform": "auto",
  "mode": "full",
  "repo_root": null,
  "axiomzero_dir": "~/.axiomzero",
  "state_db": "~/.axiomzero/state.db",
  "ollama_url": "http://localhost:11434",
  "vectordb_url": "http://localhost:8001",
  "api_port": 8000,
  "thin_client_server": null,
  "log_level": "INFO",
  "max_task_cycles": 5,
  "models": {
    "strategic": "llama3.1:8b",
    "math": "qwen2.5-coder:7b",
    "test": "qwen2.5-coder:1.5b",
    "embed": "nomic-embed-text",
    "max_concurrent_heavy": 2,
    "vram_pause_threshold_pct": 90
  },
  "managers": {
    "m1_geometry": {"enabled": true, "model": "strategic"},
    "m2_field": {"enabled": true, "model": "strategic"},
    "m3_symbolic": {"enabled": true, "model": "math"},
    "m4_test": {"enabled": true, "model": "test"},
    "m5_rag": {"enabled": true, "model": "embed"},
    "m6_web": {"enabled": true, "model": "strategic"},
    "m7_executive": {"enabled": true, "model": "strategic"}
  },
  "mcp": {
    "filesystem": {
      "enabled": true,
      "allowed_roots": [],
      "readonly_outside_allowed": true
    },
    "execution": {
      "enabled": true,
      "whitelist": ["pytest", "python", "git status", "git diff", "git log"],
      "blocked_patterns": ["rm -rf", "git reset --hard", "git push --force", "sudo rm"]
    },
    "browser": {
      "enabled": true,
      "allowed_domains": [
        "arxiv.org", "ui.adsabs.harvard.edu", "api.semanticscholar.org",
        "inspirehep.net", "zenodo.org", "github.com"
      ]
    }
  },
  "hils": {
    "human": "ThomasCory Walker-Pearson",
    "protected_files": ["FALLIBILITY.md", "SEPARATION.md", "CLAIM_MASTER_BOARD.md"],
    "protected_actions": [
      "pillar_renumber",
      "authorship_change",
      "falsification_edit",
      "git_commit_main"
    ],
    "approval_required_for_commit": true
  },
  "rag": {
    "index_paths": [
      "src/", "tests/", "recycling/", "proof/",
      "6-MONOGRAPH/", "FALLIBILITY.md", "docs/CLAIM_MASTER_BOARD.md"
    ],
    "chunk_size": 512,
    "chunk_overlap": 64,
    "collection_name": "unitary_manifold"
  },
  "web_research": {
    "arxiv_categories": ["gr-qc", "hep-th", "astro-ph.CO"],
    "brave_api_key_env": "BRAVE_API_KEY",
    "max_daily_queries": 500
  }
}
