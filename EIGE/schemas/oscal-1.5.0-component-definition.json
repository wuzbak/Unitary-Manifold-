{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pages.nist.gov/OSCAL/schemas/json/oscal_component-definition_schema.json",
  "title": "OSCAL 1.5.0 Component Definition (EIGE Bundle)",
  "description": "Bundled JSON Schema for OSCAL 1.5.0 component-definition documents used by EIGE NIST SP-800-53 R5 compliance artifacts.",
  "type": "object",
  "required": ["component-definition"],
  "additionalProperties": false,
  "properties": {
    "component-definition": {
      "type": "object",
      "required": ["uuid", "metadata", "components"],
      "additionalProperties": true,
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "A machine-oriented, globally unique identifier for the component definition."
        },
        "metadata": {
          "type": "object",
          "required": ["title", "last-modified", "version", "oscal-version"],
          "additionalProperties": true,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "last-modified": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "oscal-version": {
              "type": "string",
              "pattern": "^1\\.5\\."
            },
            "parties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uuid", "type", "name"],
                "properties": {
                  "uuid": { "type": "string" },
                  "type": { "type": "string", "enum": ["person", "organization"] },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "type", "title", "description", "control-implementations"],
            "additionalProperties": true,
            "properties": {
              "uuid": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "software",
                  "hardware",
                  "service",
                  "policy",
                  "process",
                  "procedure",
                  "plan",
                  "guidance",
                  "standard",
                  "validation"
                ]
              },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "control-implementations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["uuid", "source", "description", "implemented-requirements"],
                  "additionalProperties": true,
                  "properties": {
                    "uuid": { "type": "string" },
                    "source": { "type": "string" },
                    "description": { "type": "string" },
                    "implemented-requirements": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["uuid", "control-id"],
                        "additionalProperties": true,
                        "properties": {
                          "uuid": { "type": "string" },
                          "control-id": {
                            "type": "string",
                            "pattern": "^[A-Za-z]{1,4}-[0-9]+(\\([0-9]+\\))?$"
                          },
                          "description": { "type": "string" },
                          "remarks": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "back-matter": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
