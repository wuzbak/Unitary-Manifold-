{
  "description": "CodeQL path slices. Python is analysed per slice because a single repository-wide database exceeds the analysis size limit. TOOLS/checks/codeql_slices.py check fails CI if a tracked file of a language listed under 'coverage' is in no slice.",
  "coverage": {
    "python": [
      ".py"
    ]
  },
  "coverage_exclusions": {
    "python": {}
  },
  "paths_ignore": [
    "**/*.md",
    "**/*.txt",
    "**/*.html",
    "**/*.xml",
    "**/*.pdf",
    "**/target/**",
    "**/node_modules/**",
    "**/.venv/**",
    "public-site/**",
    "9-INFRASTRUCTURE/repomix-output.xml"
  ],
  "slices": [
    {
      "slice_id": "python-core-src",
      "language": "python",
      "build_mode": "none",
      "paths": [
        "src",
        "claims"
      ]
    },
    {
